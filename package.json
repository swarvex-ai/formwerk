{
  "name": "formwerk",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/catalog.mjs",
    "typecheck": "tsc --noEmit",
    "test:core": "vitest run",
    "test:scene": "npm run build && node tests/scene/run.mjs",
    "test": "tsc --noEmit && vitest run && node tests/scene/sounds.mjs && node tests/scene/sprites.mjs && node tests/scene/icons.mjs && npm run build && node tests/scene/run.mjs",
    "test:sound": "node tests/scene/sounds.mjs",
    "test:sprite": "node tests/scene/sprites.mjs",
    "test:icon": "node tests/scene/icons.mjs",
    "test:speech": "npm run build && node tests/speech/quality.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "pixelmatch": "8.0.0",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "description": "Assets as code for games, apps, teaching and research: parametric 3D models and tiling surfaces for three.js, surfaces as PNG maps up to 8192 pixels, pixel sprites with Godot SpriteFrames, interface icons as SVG and PNG, and sounds (voices included) for any engine, each a function of its parameters. Change the values, share the link, download .glb, .usdz, .obj, .png, .svg, .tres or .wav. CC0.",
  "license": "MIT",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sounds": "./src/sounds/lib.ts",
    "./sprites": "./src/sprites/lib.ts",
    "./icons": "./src/icons/lib.ts"
  },
  "keywords": [
    "three.js",
    "procedural",
    "parametric",
    "3d-assets",
    "tsl",
    "webgpu",
    "gltf",
    "game-assets",
    "sound-effects",
    "procedural-audio",
    "wav",
    "pbr-textures",
    "tileable-textures",
    "procedural-textures",
    "procedural-voice",
    "pixel-art",
    "sprites",
    "godot",
    "icons",
    "svg-icons",
    "ui-icons",
    "ui-sounds"
  ],
  "workspaces": [
    "speech"
  ],
  "overrides": {
    "onnxruntime-node": "file:./speech/stubs/onnxruntime-node",
    "sharp": "file:./speech/stubs/sharp"
  }
}
