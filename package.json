{
  "name": "formwerk",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/catalog.mjs",
    "typecheck": "tsc --noEmit",
    "test:core": "vitest run",
    "test:scene": "npm run build && node tests/scene/run.mjs",
    "test": "tsc --noEmit && vitest run && node tests/scene/sounds.mjs && npm run build && node tests/scene/run.mjs",
    "test:sound": "node tests/scene/sounds.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "pixelmatch": "8.0.0",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "description": "Game assets as code: parametric 3D models for three.js and sounds for any engine, each a function of its parameters. Change the values, share the link, download .glb, .usdz, .obj or .wav. CC0.",
  "license": "MIT",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sounds": "./src/sounds/lib.ts"
  },
  "keywords": [
    "three.js",
    "procedural",
    "parametric",
    "3d-assets",
    "tsl",
    "webgpu",
    "gltf",
    "game-assets",
    "sound-effects",
    "procedural-audio",
    "wav"
  ]
}
